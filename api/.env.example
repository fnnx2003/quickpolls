# Copy to .env for local runs (node --env-file=.env src/server.js). Never commit real secrets.
PORT=3000
DATABASE_URL=postgres://polls:polls@localhost:5432/polls
# Alternatively, instead of DATABASE_URL:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=polls
# PGPASSWORD=polls
# PGDATABASE=polls
APP_VERSION=dev
CORS_ORIGIN=
RUN_MIGRATIONS=true
ENABLE_CHAOS=false
SHUTDOWN_TIMEOUT_MS=10000
